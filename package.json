{
  "name": "violet-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Local desktop workspace for Obsidian handwritten-note agents",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs && npm run build",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.onurdursun.violetvault",
    "productName": "Violet Vault",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "agents/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "artifactName": "Violet-Vault-${version}-${arch}.${ext}"
    }
  }
}
